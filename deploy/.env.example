AWS_REGION=us-east-1
TABLE_NAME=devops-capstone-notes
BUCKET_NAME=devops-capstone-uploads-123456789012
SECRET_PARAM_NAME=/devops-capstone/admin-key
LOG_GROUP=/devops-capstone/app
